# Modèle du fichier .env, lu par docker compose.
#   cp .env.example .env    puis remplir les valeurs.
# Le vrai .env est ignoré par git : n'y mettez jamais de secret ici.
#
# Les valeurs laissées vides le sont exprès : docker-compose.yml utilise
# ${VAR:?...}, donc la stack refuse de démarrer tant qu'elles manquent,
# au lieu de lancer frpc avec une configuration bidon.

# --- Tunnel FRP (consommé par le conteneur frpc, voir frp/frpc.toml) ---

# Adresse du serveur FRP distant (nom de domaine ou IP), celui qui
# termine le HTTPS.
FRP_SERVER_ADDRESS=

# Port d'écoute de frps sur ce serveur (« bindPort » côté serveur,
# 7000 par défaut).
FRP_SERVER_BIND_PORT=7000

# Port ouvert sur le serveur distant pour ce site : le serveur y renvoie
# le trafic, que frpc relaie ensuite vers nginx.
FRP_SERVER_REMOTE_PORT=

# Jeton partagé avec frps (« auth.token » côté serveur). Pour en générer
# un : openssl rand -hex 32
FRP_AUTH_TOKEN=

# --- Formulaire de contact ---

# Pense-bête uniquement, rien ne le lit à l'exécution : l'adresse
# réellement utilisée est l'attribut action du formulaire, dans
# index.html et en/index.html.
FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
